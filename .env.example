# Stagehand environment — copy to `.env` and fill in. Placeholders only; never
# commit real secrets. Local development uses the component-based defaults below;
# production should set DATABASE_URL / REDIS_URL / CLICKHOUSE_* to managed hosts.

# App
APP_ENV=development
API_PORT=8000
FRONTEND_URL=http://localhost:5173
# Extra allowed CORS origins (comma-separated). In production add the Vercel URL.
# localhost:5173 and localhost:5174 are always allowed.
BACKEND_CORS_ORIGINS=

# Deployment mode — "local" (full stack) or "hosted_demo" (free-tier: no ClickHouse,
# no separate worker; the API runs short mock demo runs itself). The four flags below
# default from this mode when left blank; set one explicitly to override its default.
#   local       -> CLICKHOUSE_ENABLED=true  WORKER_ENABLED=true  HOSTED_DEMO_EXECUTION=false TRACE_STORAGE=clickhouse
#   hosted_demo -> CLICKHOUSE_ENABLED=false WORKER_ENABLED=false HOSTED_DEMO_EXECUTION=true  TRACE_STORAGE=postgres
DEPLOYMENT_MODE=local
CLICKHOUSE_ENABLED=
WORKER_ENABLED=
HOSTED_DEMO_EXECUTION=
TRACE_STORAGE=
# AI provider: "mock" (default; deterministic, no keys/cost) — required for hosted demo.
AI_PROVIDER=mock

# PostgreSQL
# Production (Neon/Supabase/Render): set a single DATABASE_URL. `postgres://` and
# `postgresql://` schemes are normalized to the psycopg2 driver automatically.
# Leave DATABASE_URL blank locally to use the POSTGRES_* components below.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stagehand
POSTGRES_USER=stagehand
POSTGRES_PASSWORD=stagehand

# Redis (Upstash in production: rediss://default:<token>@<host>:6379)
REDIS_URL=redis://localhost:6379/0

# ClickHouse
# Local Docker: host=localhost port=8123 secure=false.
# ClickHouse Cloud: host=<id>.clickhouse.cloud port=8443 secure=true.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=stagehand
CLICKHOUSE_SECURE=false

# Auth
JWT_SECRET=replace_me
JWT_EXPIRES_MINUTES=1440

# AI Providers (optional — a mock provider is used when keys are absent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CHEAP_MODEL_NAME=
STRONG_MODEL_NAME=
DEFAULT_EVAL_MODEL_NAME=

# Cost Limits
DEFAULT_MAX_COST_USD=0.50
DEFAULT_MAX_STEPS=25
DEFAULT_MAX_RUNTIME_SECONDS=120

# UCB adaptive routing
UCB_EXPLORATION_WEIGHT=1.0

# Billing (test mode only — never real charges)
# BILLING_MODE: "mock" (default) or "stripe_test". stripe_test requires a test
# secret key (sk_test_...). Leave blank for local/mock billing.
BILLING_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
