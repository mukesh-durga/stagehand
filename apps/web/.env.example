# Base URL of the Stagehand backend API.
VITE_API_BASE_URL=http://localhost:8000

# Optional: explicit WebSocket base URL for live traces. When omitted it is
# derived from VITE_API_BASE_URL (http -> ws, https -> wss). Set this only when
# the WS origin differs from the HTTP API origin.
# VITE_WS_BASE_URL=wss://your-api.onrender.com
